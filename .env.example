# Leave blank when the backend shares the frontend origin.
NEXT_PUBLIC_KOVA_API_BASE_URL=

# Supabase project settings (Project Settings > API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Phone notifications (optional; the menu item hides while these are blank).
# Make a pair with `pnpm dlx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only.
VAPID_PRIVATE_KEY=
# Who push services contact about KOVA's pushes: mailto: or https: URL.
VAPID_SUBJECT=
# Server-only. The database sends it with each push (0070); store the same
# value in Vault as push_send_secret.
PUSH_SEND_SECRET=

# Account emails: invites, confirm-email and password-reset links (0072).
# Production: a Gmail account with an App password (smtp.gmail.com, 465).
# Locally: Supabase's Mailpit, SMTP_HOST=127.0.0.1 and SMTP_PORT=54325, no
# login; read the mail at http://127.0.0.1:54324. Left blank in development,
# emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
# Server-only.
SMTP_PASS=
MAIL_FROM=
# The base of every emailed link, e.g. https://kc-kova.vercel.app
APP_URL=
